# Server-side only — read in app/api/recipe-chat+api.ts. Never prefix this
# with EXPO_PUBLIC_: that would bundle it into the client and expose it.
ANTHROPIC_API_KEY=sk-ant-...

# Server-side only — read in agent/dev-instagram-agent.ts today (a real
# server route later). Never prefix with EXPO_PUBLIC_. Get a key at
# https://app.scrapecreators.com — used by
# agent/providers/scrapecreators-instagram.ts to fetch public Instagram
# Reel/post metadata (creator, caption, external links, media URL).
SCRAPECREATORS_API_KEY=...
