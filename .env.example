# Server-side only. Read exclusively by the `+api.ts` routes, which are
# guaranteed to run server-side: app/api/recipe-chat+api.ts,
# app/api/extract-recipe+api.ts, and app/api/extract-instagram-recipe+api.ts.
# Nothing under ai/ or agent/ reads process.env itself — they take the key
# as a parameter — so this value has exactly one way into the app.
# NEVER prefix this with EXPO_PUBLIC_: that would bundle it into the client
# and expose it to anyone using the app.
ANTHROPIC_API_KEY=sk-ant-...

# Server-side only — read by app/api/extract-instagram-recipe+api.ts (and
# by the agent dev CLIs, see package.json's agent:* scripts). Never prefix
# with EXPO_PUBLIC_. Get a key at https://app.scrapecreators.com — used by
# agent/providers/scrapecreators-instagram.ts to fetch public Instagram
# Reel/post metadata (creator, caption, external links, media URL) and by
# agent/providers/scrapecreators-transcript.ts for spoken-audio
# transcripts. Only the Instagram import path needs this; website recipe
# extraction works without it.
SCRAPECREATORS_API_KEY=...
